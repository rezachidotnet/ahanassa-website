# W32 (W29 P2) — daily buffer hygiene (D-IR-1): PII clear 30 days after Odoo confirmed, local file retention, purge. deploy/iran/RUNBOOK_P2.md.
[Unit]
Description=Ahan Assa domestic RFQ: maintain (%i)

[Service]
Type=oneshot
User=ahanassa-rfq
Group=ahanassa-rfq
ExecStart=/usr/local/lib/ahanassa-node/bin/node --disable-warning=ExperimentalWarning /srv/ahanassa/site/%i/current/rfq/rfq-ir.mjs maintain /etc/ahanassa/rfq-%i.json
TimeoutStartSec=30min
MemoryMax=256M
Nice=10
ReadWritePaths=/var/lib/ahanassa-rfq/%i
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
