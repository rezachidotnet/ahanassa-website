# W32 (W29 P2) — daily: that copy + the files of UNDELIVERED RFQs → Arvan Object Storage (D-IR-9). deploy/iran/RUNBOOK_P2.md.
[Unit]
Description=Ahan Assa domestic RFQ: backup-offsite (%i)

[Service]
Type=oneshot
User=ahanassa-rfq
Group=ahanassa-rfq
ExecStart=/usr/local/lib/ahanassa-node/bin/node --disable-warning=ExperimentalWarning /srv/ahanassa/site/%i/current/rfq/rfq-ir.mjs backup /etc/ahanassa/rfq-%i.json --offsite
LoadCredential=backup-s3:/etc/ahanassa/credentials/rfq-%i/backup-s3
TimeoutStartSec=30min
MemoryMax=256M
Nice=10
ReadWritePaths=/var/lib/ahanassa-rfq/%i /var/backups/ahanassa-rfq/%i
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
