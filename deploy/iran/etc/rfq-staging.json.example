{
  "env": "staging",
  "listen": { "host": "127.0.0.1", "port": 8712 },
  "public_origin": "https://api-staging.ahanassa.ir",
  "allowed_origins": ["https://staging.ahanassa.ir"],
  "data_dir": "/var/lib/ahanassa-rfq/staging",
  "release_dir": "/srv/ahanassa/site/staging/current",
  "captcha": { "provider": "arcaptcha", "site_key": "<ARCAPTCHA_SITE_KEY — public, from the arCaptcha panel>" },
  "files_enabled": true,
  "odoo": { "base_url": "https://ahanassa-v11-odoo-stub-staging.nova-b1e6f0.workers.dev", "intake_v11": true },
  "r2": { "endpoint": "https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com", "bucket": "ahanassa-v11-rfq-files-ir-staging", "region": "auto" },
  "r2_wait_ms": 7200000,
  "files_storage_hint": "held on the domestic server; open with https://api-staging.ahanassa.ir/__admin/ir/",
  "bale": { "chat_id": "<BALE_STAFF_GROUP_CHAT_ID>" },
  "backup": {
    "dir": "/var/backups/ahanassa-rfq/staging",
    "age_recipient": "<age1… — the OWNER's public key; the private key never comes to this server>",
    "offsite": { "endpoint": "https://s3.ir-thr-at1.arvanstorage.ir", "bucket": "<ARVAN_BACKUP_BUCKET>", "region": "ir-thr-at1" }
  }
}
