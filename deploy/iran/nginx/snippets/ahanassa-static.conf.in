# W30 domestic copy — serve the @ENV@ release like the static Worker on www.ahanassa.com
# (workers/static/wrangler.jsonc: html_handling "auto-trailing-slash", not_found_handling "404-page", _redirects and
# _headers). Included inside a `server {}` block. The parity test (scripts/iran/parity.ts) pins every status code,
# Location, Content-Type and header against www.ahanassa.com; this file is changed when the parity test says so.
root /srv/ahanassa/site/@ENV@/current/public;
server_tokens off;
etag on;
charset utf-8;
charset_types text/plain text/css text/xml text/markdown application/javascript application/json application/xml image/svg+xml application/manifest+json;
# Precompressed by the activator (.gz always, .br when the brotli binary exists); on the fly only for the rest.
gzip_static on;
gzip on;
gzip_vary on;
gzip_min_length 256;
gzip_types text/plain text/css text/xml text/markdown application/javascript application/json application/xml image/svg+xml application/manifest+json;
include /etc/nginx/snippets/ahanassa-brotli*.conf;

# 1. _redirects — before any file lookup, without the /* headers (Cloudflare: "the redirect will win out").
if ($ah_@ENV@_r301) { return 301 $ah_@ENV@_r301$is_args$args; }
if ($ah_@ENV@_r302) { return 302 $ah_@ENV@_r302$is_args$args; }
if ($ah_@ENV@_r307) { return 307 $ah_@ENV@_r307$is_args$args; }
if ($ah_@ENV@_r308) { return 308 $ah_@ENV@_r308$is_args$args; }

# 2. 404: the nearest 404.html, with status 404.
error_page 404 /__ahanassa_404$ah_@ENV@_nf;
location ^~ /__ahanassa_404/ {
    internal;
    include /etc/nginx/snippets/ahanassa-headers-@ENV@.conf;
    rewrite ^/__ahanassa_404(/.*)$ $1 break;
}

# 3. Never served: the Worker's own rule files, and the derived precompressed twins (served only through gzip_static).
location ~ ^/(?:_headers|_redirects|\.assetsignore)$ { return 404; }
location ~ \.(?:gz|br)$ { return 404; }

# 4. html_handling "auto-trailing-slash" (Cloudflare's table): /x -> x.html; /x.html, /x/, /x/index(.html) -> 307 /x;
#    a directory /d -> 307 /d/; /d/ -> d/index.html.
location = / {
    include /etc/nginx/snippets/ahanassa-headers-@ENV@.conf;
    try_files /index.html =404;
}
location = /index.html { return 307 /$is_args$args; }
location ~ ^(?<ah_base>/.+)/index(?:\.html)?$ {
    include /etc/nginx/snippets/ahanassa-headers-@ENV@.conf;
    if (-f $document_root$ah_base/index.html) { return 307 $ah_base$is_args$args; }
    if (-f $document_root$ah_base.html) { return 307 $ah_base$is_args$args; }
    try_files $uri $uri.html =404;
}
location ~ ^(?<ah_base>/.+)\.html$ {
    include /etc/nginx/snippets/ahanassa-headers-@ENV@.conf;
    if (-f $request_filename) { return 307 $ah_base$is_args$args; }
    return 404;
}
location ~ ^(?<ah_base>/.+)/$ {
    include /etc/nginx/snippets/ahanassa-headers-@ENV@.conf;
    if (-f $document_root$ah_base.html) { return 307 $ah_base$is_args$args; }
    try_files ${uri}index.html =404;
}
location / {
    include /etc/nginx/snippets/ahanassa-headers-@ENV@.conf;
    try_files $uri $uri.html @ahanassa_dir;
}
location @ahanassa_dir {
    include /etc/nginx/snippets/ahanassa-headers-@ENV@.conf;
    if (-f $document_root$uri/index.html) { return 307 $uri/$is_args$args; }
    return 404;
}
