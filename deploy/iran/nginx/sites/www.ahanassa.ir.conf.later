# W30 domestic copy — www.ahanassa.ir (production release). Installed as /etc/nginx/sites-available/www.ahanassa.ir.conf + sites-enabled symlink
# (RUNBOOK_P1.md §3). Reached only through ArvanCloud: the firewall admits 80/443 from Arvan's 14 IPv4 ranges only.
# !!! NOT INSTALLED IN P1. Owner decision, not now: enabled only in the LATER Arvan origin switch for www.ahanassa.ir
# (RUNBOOK_P1.md §10). Until then www.ahanassa.ir's Arvan origin stays www.ahanassa.com and this file stays here.
server {
    listen 80;
    server_name www.ahanassa.ir ahanassa.ir;
    include /etc/nginx/snippets/ahanassa-acme.conf;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.ahanassa.ir ahanassa.ir;
    ssl_certificate /etc/ahanassa/tls/www.ahanassa.ir/fullchain.pem;
    ssl_certificate_key /etc/ahanassa/tls/www.ahanassa.ir/privkey.pem;
    include /etc/nginx/snippets/ahanassa-tls.conf;
    include /etc/nginx/snippets/ahanassa-arvan-real-ip.conf;
    access_log /var/log/nginx/ahanassa-production.access.log;
    error_log /var/log/nginx/ahanassa-production.error.log warn;
    include /etc/nginx/snippets/ahanassa-static-production.conf;
}
