// Standalone RFQ Worker (architecture V1.1 §4.3, §6; website W2).
// Deploy: npx wrangler deploy --config workers/rfq/wrangler.jsonc --env staging
// env.production (W8.0): prepared side by side with the live site, workers.dev only, DELIVERY OFF (see there).
// Entries (W3 C1): top-level `main` = index.ts, the PRODUCTION entry (no test code);
// env.staging.main = index.staging.ts (adds the /__admin/test/* routes, TEST_HOOKS=1).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ahanassa-v11-rfq-local",
  "main": "index.ts",
  "compatibility_date": "2026-08-26",
  // nodejs_compat: libphonenumber/Web Crypto helpers; global_fetch_strictly_public: the
  // delivery fetch to the staging Odoo stub (same account, workers.dev) goes over the public route.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "ahanassa-v11-rfq-staging",
      "main": "index.staging.ts",
      "workers_dev": false,
      "routes": [{ "pattern": "api-staging.ahanassa.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB_OPS", "database_name": "ahanassa-v11-ops-staging", "database_id": "938579c2-c28a-4765-a7da-86d9c198072f", "migrations_dir": "../../migrations" },
        // Read-only use by the Worker (rfq_variant_index + publication_pointer, A8).
        { "binding": "DB_PUBLIC", "database_name": "ahanassa-v11-public-staging", "database_id": "8902191f-3dd6-4714-a785-ac0149657ac3", "migrations_dir": "../../migrations_public" }
      ],
      "queues": {
        "producers": [{ "binding": "RFQ_QUEUE", "queue": "ahanassa-v11-rfq-staging" }],
        "consumers": [
          // One message = one RFQ (A5). The D1 outbox stays authoritative; the DLQ only logs.
          { "queue": "ahanassa-v11-rfq-staging", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "ahanassa-v11-rfq-staging-dlq" },
          { "queue": "ahanassa-v11-rfq-staging-dlq", "max_batch_size": 1 }
        ]
      },
      // Staging namespace; 20/60 s per client-IP key. Missing/failing binding -> 503 (fail-closed).
      "ratelimits": [
        { "name": "RFQ_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 20, "period": 60 } },
        // W13.3: POST /api/rfqs/extract — 6 readings / 60 s per client-IP key (each costs Workers AI time). Missing -> 503.
        { "name": "RFQ_EXTRACT_RATE_LIMITER", "namespace_id": "1104", "simple": { "limit": 6, "period": 60 } }
      ],
      // W13.3: Workers AI for reading pictures/PDFs of item lists (docs/RFQ_INSTANT_EXTRACT.md). Nothing is stored.
      "ai": { "binding": "AI" },
      // Cron reconciler: one due RFQ per run (§6.4). Account cap: 5 triggers.
      "triggers": { "crons": ["*/5 * * * *"] },
      // D-RFQ-FILE: PRIVATE bucket for RFQ files (no r2.dev URL, no custom domain), EU jurisdiction
      // (PROJECT_OVERRIDES.md D1/R2 jurisdiction decision). Created 2026-10-13:
      //   npx wrangler r2 bucket create ahanassa-v11-rfq-files-staging --jurisdiction eu
      "r2_buckets": [{ "binding": "RFQ_FILES", "bucket_name": "ahanassa-v11-rfq-files-staging", "jurisdiction": "eu" }],
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_ORIGINS": "https://ahanassa-v11-static-staging.nova-b1e6f0.workers.dev",
        "TURNSTILE_EXPECTED_HOSTNAMES": "ahanassa-v11-static-staging.nova-b1e6f0.workers.dev",
        // Staging NEVER delivers to production Odoo (§6.7): the contract stub.
        "ODOO_BASE_URL": "https://ahanassa-v11-odoo-stub-staging.nova-b1e6f0.workers.dev",
        "ODOO_INTAKE_V11": "1",
        // W2 CPU decision (§4.3, p99 <= 7 ms): the Queue consumer measured p99 8 ms on staging, so
        // Queue delivery and the post-commit hand-off are off; the cron reconciler (p99 7 ms) and the
        // CI reconciler deliver. Re-enable only with new tail evidence.
        "DELIVERY_ON_QUEUE": "0",
        "DELIVERY_ON_CRON": "1",
        "QUEUE_FAST_PATH": "0",
        // File upload on (needs the RFQ_FILES bucket above). docs/RFQ_FILE_UPLOAD.md.
        "RFQ_FILES_ENABLED": "1",
        // W13.3 instant extraction (needs file upload on + the AI binding above). docs/RFQ_INSTANT_EXTRACT.md.
        "RFQ_EXTRACT_ENABLED": "1",
        "TEST_HOOKS": "1"
      }
      // Secrets (wrangler secret put --env staging): TURNSTILE_SECRET_KEY, ODOO_RFQ_API_TOKEN (= stub bearer), ADMIN_TOKEN.
    },
    // W8.0 production preparation (owner-authorized 2026-10-04), live since the W8.1 cutover (2026-10-05):
    // custom domain api.ahanassa.com; delivery by the */5 cron reconciler to production Odoo (bearer =
    // the Odoo `next` slot, secret ODOO_RFQ_API_TOKEN); Queue delivery stays off (W2 CPU decision).
    // Production entry index.ts (no test routes). Secrets: TURNSTILE_SECRET_KEY (production widget), ODOO_RFQ_API_TOKEN.
    // The */5 cron took the slot of the removed ahanassa-bootstrap-staging cron (account 5/5).
    "production": {
      "name": "ahanassa-v11-rfq-production",
      "main": "index.ts",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [{ "pattern": "api.ahanassa.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB_OPS", "database_name": "ahanassa-v11-ops-production", "database_id": "72b8fb96-43c5-45bd-8f1e-b0f2a3a2fa9a", "migrations_dir": "../../migrations" },
        // Read-only use by the Worker (rfq_variant_index + publication_pointer, A8).
        { "binding": "DB_PUBLIC", "database_name": "ahanassa-v11-public-production", "database_id": "6e74ff59-9961-40f2-b8e5-8a9619f45776", "migrations_dir": "../../migrations_public" }
      ],
      // Own namespace (staging 1102, legacy production 2001); 20/60 s per client-IP key; missing -> 503.
      "ratelimits": [
        { "name": "RFQ_RATE_LIMITER", "namespace_id": "1103", "simple": { "limit": 20, "period": 60 } },
        // W13.3: POST /api/rfqs/extract — 6 readings / 60 s per client-IP key (staging 1104). Missing -> 503.
        { "name": "RFQ_EXTRACT_RATE_LIMITER", "namespace_id": "1105", "simple": { "limit": 6, "period": 60 } }
      ],
      // W13.3: Workers AI for reading pictures/PDFs of item lists (docs/RFQ_INSTANT_EXTRACT.md). Nothing is stored.
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["*/5 * * * *"] },
      // D-RFQ-FILE: PRIVATE bucket for RFQ files (no r2.dev URL, no custom domain), EU jurisdiction.
      // Created by the owner 2026-10-16 (dashboard, jurisdiction eu); migration 0009 is applied to production DB_OPS.
      "r2_buckets": [{ "binding": "RFQ_FILES", "bucket_name": "ahanassa-v11-rfq-files-production", "jurisdiction": "eu" }],
      "vars": {
        "APP_ENV": "production",
        // W27 Iran mirror (owner 2026-10-22): www.ahanassa.ir / ahanassa.ir are ArvanCloud CDN hostnames in front of
        // www.ahanassa.com (for MCI mobile users who cannot reach Cloudflare); the form there posts to api.ahanassa.ir
        // (Arvan -> api.ahanassa.com). The Turnstile widget must list the same two hostnames (dashboard).
        "ALLOWED_ORIGINS": "https://www.ahanassa.com,https://www.ahanassa.ir,https://ahanassa.ir",
        "TURNSTILE_EXPECTED_HOSTNAMES": "www.ahanassa.com,www.ahanassa.ir,ahanassa.ir",
        "ODOO_BASE_URL": "https://odoo.ahanassa.com",
        "ODOO_INTAKE_V11": "1",
        "DELIVERY_ON_QUEUE": "0",
        "DELIVERY_ON_CRON": "1",
        "QUEUE_FAST_PATH": "0",
        // File upload ON since W20.4 (owner 2026-10-16; needs the RFQ_FILES bucket above). docs/RFQ_FILE_UPLOAD.md.
        // The §8 control is accepted (DAR-065, 2026-10-13).
        "RFQ_FILES_ENABLED": "1",
        // W13.3 instant extraction ON since W20.4 (needs file upload on + the AI binding and
        // RFQ_EXTRACT_RATE_LIMITER above). docs/RFQ_INSTANT_EXTRACT.md.
        "RFQ_EXTRACT_ENABLED": "1"
      }
    }
  }
}
