{
  "name": "ahanassa-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "tailwind-merge": "latest",
    "vinext": "latest",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.3.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "sharp": "0.35.2",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.126.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "test": "node --test lib/**/*.test.ts components/**/*.test.ts scripts/ops/**/*.test.ts",
    "build:static": "node scripts/static/build.ts",
    "static:gate": "node scripts/static/gate.ts",
    "static:hydration": "node scripts/static/hydration-check.ts"
  }
}
