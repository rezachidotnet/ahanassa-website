/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ahanassa-bootstrap",
	"compatibility_date": "2026-08-26",
	// Custom entry (delegates to vinext/server/fetch-handler for all HTTP
	// traffic) so this Worker can also export `queue` and `scheduled` for the
	// RFQ -> Odoo sync path. See workers/entry.ts.
	"main": "workers/entry.ts",
	"triggers": {
		// Three independent scheduled jobs, routed by the literal cron string
		// inside the single shared `scheduled()` handler (workers/entry.ts) —
		// Workers supports multiple cron triggers per Worker this way.
		// `triggers` is a shared (non-per-environment) config key, but each
		// named environment is still a physically separate deployed Worker
		// with its own D1/Queue bindings, so these schedules never cross
		// environments (docs/CATALOG_SYNC_OPERATIONS.md "Environment
		// separation").
		//
		//   "*/5 * * * *"  — RFQ outbox reconciliation sweep (unchanged,
		//                    01-sources/TECHNICAL_ARCHITECTURE.md §12.3/§14.5)
		//   "0 */3 * * *"  — Catalog incremental sync, every 3 hours
		//                    (DOCUMENT_AUDIT_REPORT.md DAR-040,
		//                    docs/CATALOG_SYNC_OPERATIONS.md §Incremental
		//                    schedule — the Product Master changes at
		//                    business-decision cadence, not continuously)
		//   "30 2 * * *"   — Catalog full reconciliation, once daily at
		//                    02:30 UTC (a low-traffic window for this B2B
		//                    site's expected time zone) — detects
		//                    archived/deactivated upstream records, which
		//                    incremental sync structurally cannot
		//                    (docs/CATALOG_SYNC_OPERATIONS.md §Full
		//                    reconciliation schedule)
		//
		// PENDING DEPLOYMENT: these Cron triggers are configuration only —
		// they do not become live/active until this Worker is actually
		// deployed (`wrangler deploy --env <name>`), which has not happened
		// for any environment yet. Activation is a Claude Deployment Stage 1
		// step, not this task's.
		"crons": ["*/5 * * * *", "0 */3 * * *", "30 2 * * *"]
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 *
	 * RFQ backend foundation (feat/rfq-backend branch): DB_OPS and the
	 * ODOO_SYNC_QUEUE producer/consumer/DLQ are now configured — RFQ
	 * intake/persistence/sync-handoff is in scope for this branch.
	 * PUBLIC_MEDIA and RFQ_ATTACHMENTS remain commented out: RFQ attachment
	 * upload stays blocked on the unresolved scanning-pipeline decision
	 * — PROJECT_OVERRIDES.md §8.
	 *
	 * DB_PUBLIC (catalog foundation, DOCUMENT_AUDIT_REPORT.md DAR-033):
	 * binding/schema architecture only — no real Cloudflare D1 database has
	 * been created for this (`wrangler d1 create` has never been run for
	 * DB_PUBLIC in any environment). Live `ahanassa` Odoo product data was
	 * verified empty (0 product.template/product.product rows) during the
	 * same audit, so there is nothing to synchronize into a production
	 * DB_PUBLIC yet — provisioning it is deferred until real Odoo catalog
	 * data exists, per that task's explicit "do not provision unless
	 * clearly needed" instruction. Local dev works against the placeholder
	 * `database_id` exactly like DB_OPS did before staging existed (local
	 * D1 simulation only uses it as a storage key).
	 *
	 * "database_id" below is a clearly-marked placeholder, NOT a real
	 * provisioned resource — no `wrangler d1 create` has been run. Local
	 * dev (`vinext dev` / `wrangler dev --local`) works against this
	 * placeholder because local D1 simulation only uses it as a storage
	 * key. Before any remote/staging/production deploy, run
	 * `wrangler d1 create ahanassa-ops` and replace this value with the
	 * real UUID it returns — do not deploy with the placeholder.
	 */
	"d1_databases": [
		// Distinct placeholder strings, not just distinct bindings: local D1
		// simulation keys its on-disk storage by `database_id`, so two
		// bindings sharing the same placeholder collide into one physical
		// local SQLite file (both migration sets applied to it) — caught by
		// applying migrations to each locally and diffing the resulting
		// table list (DAR-033). Keep these placeholders distinct even though
		// neither is a real provisioned resource.
		{ "binding": "DB_PUBLIC", "database_name": "ahanassa-public", "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID_PUBLIC", "migrations_dir": "migrations_public" },
		{ "binding": "DB_OPS", "database_name": "ahanassa-ops", "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID_OPS", "migrations_dir": "migrations" }
	],
	// "r2_buckets": [
	//   { "binding": "PUBLIC_MEDIA", "bucket_name": "ahanassa-public-media" },
	//   { "binding": "RFQ_ATTACHMENTS", "bucket_name": "ahanassa-rfq-attachments" }
	// ],
	/**
	 * Queue names below are also placeholders in the sense that no remote
	 * queue has been created (`wrangler queues create ...`) — local dev
	 * simulates them without that step. Create the real queues before any
	 * remote deploy.
	 */
	"queues": {
		"producers": [{ "binding": "ODOO_SYNC_QUEUE", "queue": "ahanassa-odoo-sync" }],
		"consumers": [
			{ "queue": "ahanassa-odoo-sync", "dead_letter_queue": "ahanassa-odoo-sync-dlq", "max_retries": 5 },
			{ "queue": "ahanassa-odoo-sync-dlq" }
		]
	},
	/**
	 * Workers Rate Limiting binding — protects only POST /api/rfqs
	 * (lib/security/rate-limit.ts), not the whole site. `namespace_id` is a
	 * developer-chosen identifier (unlike D1/Queue IDs, it does not require a
	 * prior `wrangler` provisioning step) — "1001" is arbitrary and does not
	 * collide with any other binding in this config. `simple.period` only
	 * accepts 10 or 60 (Cloudflare's current simple-binding constraint); 60s
	 * is used here. 5 requests / 60s per client-IP-derived key is a
	 * conservative anti-abuse starting threshold for this low-frequency B2B
	 * RFQ endpoint, not a business/commercial limit — see README.md "RFQ
	 * abuse protection" for the full rationale. This binding is intentionally
	 * permissive/eventually-consistent per Cloudflare location, never an
	 * exact accounting ledger.
	 */
	"ratelimits": [{ "name": "RFQ_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Plain (non-secret) vars belong here per environment; see .env.example
	 * for the full documented list. Cloudflare bindings/vars do not inherit
	 * across "env" blocks — each environment repeats its own vars in full
	 * once staging/production environments are added.
	 */
	// "vars": { "APP_ENV": "local", "APP_BASE_URL": "http://localhost:3001" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ],
	/**
	 * Named environments (`wrangler deploy --env <name>` / `wrangler d1
	 * migrations apply DB_OPS --env <name> --remote`). Bindings arrays
	 * (d1_databases/queues/etc.) do NOT inherit from the top level in
	 * Wrangler's environment model — each named environment repeats its own
	 * in full. `main`/`triggers`/`assets`/`compatibility_date` do inherit
	 * and are intentionally not repeated here.
	 *
	 * "staging" holds the REAL resource IDs for actual Cloudflare staging
	 * infrastructure (README.md documents how these were created and how to
	 * recreate them). The top-level (default/local) config above keeps its
	 * placeholder `database_id` — local dev is unaffected by this block.
	 *
	 * No jurisdiction/data-location policy has been formally decided
	 * (01-sources/DATABASE_SCHEMA.md §18 "Data location" gate) — the
	 * staging D1 database below was created with Cloudflare's automatic
	 * default placement (no --location flag), appropriate for
	 * infrastructure validation with synthetic test data only. A formal
	 * jurisdiction decision is required before a production database is
	 * provisioned — see DOCUMENT_AUDIT_REPORT.md DAR-024.
	 */
	"env": {
		"production": {
			// EU jurisdiction — owner-approved 2026-08-29 (PROJECT_OVERRIDES.md
			// §14, DOCUMENT_AUDIT_REPORT.md DAR-032). D1/Queue/DLQ below are real,
			// newly-created Cloudflare resources — D1 via
			// `wrangler d1 create ahanassa-ops-production --jurisdiction eu`
			// (verified `jurisdiction: eu`, `running_in_region: EEUR`), Queue/DLQ
			// via `wrangler queues create`. None of these are a promotion/copy of
			// the staging resources above (staging's automatic WEUR D1 placement
			// was never production policy — DAR-024/DAR-031). Migrations have been
			// applied (0 rows in every operational table, verified read-only).
			//
			// This config block does NOT deploy anything by itself. No production
			// Worker has been deployed, no producer/consumer is attached to these
			// queues yet (0/0 in `wrangler queues list`), no secret has been set
			// for this environment, and `ahanassa.com`/`www.ahanassa.com` remain
			// unchanged, still served by the legacy Vercel deployment. Deploying
			// this environment (`wrangler deploy --env production`), provisioning
			// its secrets, and any DNS/custom-domain cutover are separate,
			// explicitly-approved future phases — see DOCUMENT_AUDIT_REPORT.md
			// DAR-032 for the full provisioning runbook.
			"name": "ahanassa-production",
			"images": { "binding": "IMAGES" },
			"d1_databases": [
				{ "binding": "DB_OPS", "database_name": "ahanassa-ops-production", "database_id": "7240a6a7-c293-4e6e-baf3-95838a3c2944", "migrations_dir": "migrations" },
				// Website Catalog read model (DOCUMENT_AUDIT_REPORT.md DAR-035).
				// `wrangler d1 create ahanassa-public-production --jurisdiction eu`
				// — verified `jurisdiction: eu`, `running_in_region: EEUR`, matching
				// the DB_OPS production jurisdiction decision (PROJECT_OVERRIDES.md
				// §14, which is not DB_OPS-specific — the same variable name and a
				// parallel R2 invariant confirm a project-wide production data
				// jurisdiction policy). Physically separate from DB_OPS — RFQ/
				// contact/integration data never mixes with the public catalog
				// projection.
				{ "binding": "DB_PUBLIC", "database_name": "ahanassa-public-production", "database_id": "73ba6b50-ef57-4d89-baa9-617a0b0af127", "migrations_dir": "migrations_public" }
			],
			"queues": {
				"producers": [{ "binding": "ODOO_SYNC_QUEUE", "queue": "ahanassa-odoo-sync-production" }],
				"consumers": [
					{ "queue": "ahanassa-odoo-sync-production", "dead_letter_queue": "ahanassa-odoo-sync-production-dlq", "max_retries": 5 },
					{ "queue": "ahanassa-odoo-sync-production-dlq" }
				]
			},
			// Same binding name/limit as staging; a distinct namespace_id (not
			// 1001/local or 1002/staging) so production counts separately.
			"ratelimits": [{ "name": "RFQ_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }],
			// Stage 2B step 1 (workers.dev repair): explicit workers_dev=true so
			// a `wrangler triggers deploy` never again implicitly disables the
			// workers.dev preview endpoint (root cause of the 2026-09-02 404
			// regression, docs/GO_LIVE_CUTOVER_RUNBOOK.md §12). Kept true
			// permanently going forward — it costs nothing once the Custom
			// Domain is also attached.
			"workers_dev": true,
			// Worker Custom Domain — Stage 2B production cutover
			// (docs/GO_LIVE_CUTOVER_RUNBOOK.md §10). Cloudflare manages the
			// underlying DNS record for a Custom Domain automatically; the zone
			// (ahanassa.com) is already on Cloudflare nameservers. Apex
			// (ahanassa.com) is intentionally NOT listed here — it must remain
			// non-canonical and instead gets a redirect rule to
			// https://www.ahanassa.com, configured separately in Cloudflare
			// (not via Worker route/custom_domain). The conflicting legacy
			// www.ahanassa.com Vercel CNAME was removed by the project owner
			// immediately before this attachment (Stage 2B step 3).
			"routes": [{ "pattern": "www.ahanassa.com", "custom_domain": true }],
			// ODOO_API_KEY (legacy) is NOT provisioned here — DAR-041 confirmed
			// nothing in the live runtime calls it anymore; do not provision it.
			// TURNSTILE_SECRET_KEY and ODOO_RFQ_API_TOKEN are real Cloudflare
			// Secrets (`wrangler versions secret put ... --config dist/server/wrangler.json`,
			// built with CLOUDFLARE_ENV=production — see
			// docs/CLOUDFLARE_DEPLOYMENT_STAGE1.md for why the env-flattening step
			// matters), values never appear here or anywhere in Git.
			// The values below are non-secret configuration only.
			"vars": {
				"APP_ENV": "production",
				"ODOO_BASE_URL": "https://odoo.ahanassa.com",
				"ODOO_DATABASE": "ahanassa",
				"ODOO_CRM_TEAM_ID": "1",
				"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEi2RZ3NHcqTk0ej",
				// Homepage price strip (docs/pricing/PRICE_PROVIDER_CONTRACT.md) —
				// explicit default-OFF feature flag + empty enabled-provider list.
				// No price data exists yet (no real provider is configured — see
				// the doc's "safe rollout order"); flipping PRICE_STRIP_ENABLED to
				// "true" and populating ENABLED_PRICE_PROVIDERS are separate, later,
				// explicit deployment steps, never bundled with an app-code deploy.
				"PRICE_STRIP_ENABLED": "false",
				"ENABLED_PRICE_PROVIDERS": "",
				// Homepage ranking kill switch (this task's Homepage Product
				// Architecture Hardening) — "base" = deterministic base_priority +
				// manual_boost only, ignores lib/ranking/ demand aggregation
				// entirely. "auto" additionally layers in the precomputed,
				// privacy-safe RFQ-demand score. Any missing/unrecognized value
				// (including this one being absent) safely resolves to "base" —
				// lib/ranking/score.ts#resolveHomepageRankingMode never throws.
				// Flipping to "auto" is a separate, later, explicit deployment step
				// (mirrors PRICE_STRIP_ENABLED's own rollout discipline above) —
				// never bundled with an app-code deploy.
				"HOMEPAGE_RANKING_MODE": "base"
			}
		},
		"staging": {
			"name": "ahanassa-bootstrap-staging",
			"images": { "binding": "IMAGES" },
			"d1_databases": [
				{ "binding": "DB_OPS", "database_name": "ahanassa-ops-staging", "database_id": "49bd0aff-e289-4fff-b7b9-0f4b517e6b14", "migrations_dir": "migrations" },
				// Website Catalog read model (DOCUMENT_AUDIT_REPORT.md DAR-035) —
				// physically separate from DB_OPS (RFQ/contacts/integration data
				// never mixes with the public catalog projection). No jurisdiction
				// set — automatic default placement, same as ahanassa-ops-staging;
				// staging placement is never production policy.
				{ "binding": "DB_PUBLIC", "database_name": "ahanassa-public-staging", "database_id": "35cef70f-3ad3-4049-add4-ddcac6cac45b", "migrations_dir": "migrations_public" }
			],
			"queues": {
				"producers": [{ "binding": "ODOO_SYNC_QUEUE", "queue": "ahanassa-odoo-sync-staging" }],
				"consumers": [
					{ "queue": "ahanassa-odoo-sync-staging", "dead_letter_queue": "ahanassa-odoo-sync-staging-dlq", "max_retries": 5 },
					{ "queue": "ahanassa-odoo-sync-staging-dlq" }
				]
			},
			// Same binding name/limit as the top-level config; a distinct
			// namespace_id so staging counts separately from local dev.
			"ratelimits": [{ "name": "RFQ_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
			// ODOO_API_KEY is a Cloudflare Secret (wrangler secret put --env staging),
			// never a plain var. ODOO_BASE_URL/ODOO_DATABASE/ODOO_CRM_TEAM_ID are
			// non-secret configuration values per lib/env.ts#getOdooConfig and
			// lib/odoo/adapter.ts#getOdooCrmTeamId -- see README.md "Odoo staging
			// connectivity" for provisioning details (dedicated integration user,
			// minimum-permission groups, no ir.model.data/group_erp_manager
			// dependency -- DOCUMENT_AUDIT_REPORT.md DAR-027).
			// ODOO_RFQ_API_TOKEN (DAR-041, docs/ODOO_RFQ_API_INTEGRATION.md) is the
			// current RFQ delivery credential (POST /api/v1/rfq) -- not yet
			// provisioned here either; ODOO_API_KEY above is no longer the RFQ-path
			// secret, see lib/odoo/adapter.ts's deprecation note.
			"vars": {
				"APP_ENV": "staging",
				"ODOO_BASE_URL": "https://odoo.ahanassa.com",
				"ODOO_DATABASE": "ahanassa",
				"ODOO_CRM_TEAM_ID": "1",
				"PRICE_STRIP_ENABLED": "false",
				"ENABLED_PRICE_PROVIDERS": "",
				"HOMEPAGE_RANKING_MODE": "base"
			}
		}
	}
}