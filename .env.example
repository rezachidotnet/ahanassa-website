# Ahan Asa website — environment variable reference.
#
# Copy to .env.local for local development. Never commit real values.
# Canonical registry: ENVIRONMENT_VARIABLES.md (02-sources) via DOCS_INDEX.md.
# APP_BASE_URL is canonical — SITE_URL is deprecated, do not reintroduce it.
#
# Phase 1 note: this file lists the full env surface expected by the
# approved architecture, but most of it (Odoo, uploads, RFQ secrets) has no
# real implementation yet — see PROJECT_OVERRIDES.md §11 for what is/isn't a
# blocker. Do not invent real values for any entry below.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
APP_ENV=local
APP_BASE_URL=http://localhost:3001
ALLOWED_HOSTS=localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=info
RELEASE_ID=

# -----------------------------------------------------------------------------
# Public (browser-exposed via NEXT_PUBLIC_ prefix — never put secrets here)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_ENV=local
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CONSENT_MODE=

# -----------------------------------------------------------------------------
# Feature flags — default false until the gated feature actually ships
# -----------------------------------------------------------------------------
FEATURE_WHATSAPP_LINK=true
FEATURE_RFQ_UPLOADS=false
FEATURE_CATALOG=false
FEATURE_PRICING=false

# -----------------------------------------------------------------------------
# Odoo integration — out of Phase 1 scope. Names only, no values.
# -----------------------------------------------------------------------------
ODOO_BASE_URL=
ODOO_API_KEY=
ODOO_DATABASE=

# -----------------------------------------------------------------------------
# RFQ / uploads / anti-abuse — out of Phase 1 scope. Names only, no values.
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
EMAIL_API_TOKEN=
INQUIRY_REFERENCE_SECRET=
UPLOAD_SIGNING_SECRET=
WEBHOOK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare bindings (see wrangler.jsonc — not set via .env; listed here
# only for local-dev documentation of what the app expects to exist)
# -----------------------------------------------------------------------------
# D1:    DB_PUBLIC, DB_OPS
# R2:    PUBLIC_MEDIA, RFQ_ATTACHMENTS
# Queue: ODOO_SYNC_QUEUE (producer), ODOO_SYNC_DLQ (integration worker)
