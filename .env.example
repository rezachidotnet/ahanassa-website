# Ahan Asa website — environment variable reference.
#
# Copy to .env.local for local development. Never commit real values.
# Canonical registry: ENVIRONMENT_VARIABLES.md (02-sources) via DOCS_INDEX.md.
# APP_BASE_URL is canonical — SITE_URL is deprecated, do not reintroduce it.
#
# Phase 1 note: this file lists the full env surface expected by the
# approved architecture, but most of it (Odoo, uploads, RFQ secrets) has no
# real implementation yet — see PROJECT_OVERRIDES.md §11 for what is/isn't a
# blocker. Do not invent real values for any entry below.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
APP_ENV=local
APP_BASE_URL=http://localhost:3001
ALLOWED_HOSTS=localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
LOG_LEVEL=info
RELEASE_ID=

# -----------------------------------------------------------------------------
# Public (browser-exposed via NEXT_PUBLIC_ prefix — never put secrets here)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_ENV=local
NEXT_PUBLIC_GTM_ID=
# Cloudflare Turnstile site key (public, safe in browser code) — protects
# POST /api/rfqs (lib/security/turnstile.ts). Undefined until a real
# hostname/widget is provisioned; without it, the RFQ form renders without
# the widget and the server fails closed with SERVICE_UNAVAILABLE. For local
# manual testing only, use Cloudflare's official always-passing test key
# (documented at developers.cloudflare.com/turnstile/troubleshooting/testing)
# in your own untracked .env.local — never commit a real or test key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_CONSENT_MODE=

# -----------------------------------------------------------------------------
# Feature flags — default false until the gated feature actually ships
# -----------------------------------------------------------------------------
FEATURE_WHATSAPP_LINK=true
FEATURE_RFQ_UPLOADS=false
FEATURE_CATALOG=false
FEATURE_PRICING=false

# -----------------------------------------------------------------------------
# Odoo integration — mapping verified against the live `ahanassa` database
# 2026-08-28 (DOCUMENT_AUDIT_REPORT.md DAR-026); adapter code is real, but
# no API key has been minted (none should be, without the owner's explicit
# go-ahead — see DAR-026). Names only, no values.
# -----------------------------------------------------------------------------
ODOO_BASE_URL=
# Expected value once provisioned: https://odoo.ahanassa.com (verified
# reverse-proxy target: container odoo-ahantorob, database `ahanassa`).
# DEPRECATED for RFQ delivery (DAR-041) — kept only for the legacy,
# no-longer-called lib/odoo/adapter.ts. Do not reuse for the RFQ API below.
ODOO_API_KEY=
ODOO_DATABASE=
# Expected value once provisioned: ahanassa (dbfilter-locked on the server;
# not sent on the wire — see lib/odoo/client.ts file header).
# Optional. crm.team to assign website RFQs to. Left unset until the owner
# confirms which team (the only team named "Website" is inactive in the
# live database) — see lib/odoo/mapping.ts RFQ_HEADER_MAPPING.openDecisions.
# DEPRECATED for RFQ delivery (DAR-041) — CRM opportunity creation is now a
# private, Odoo-side downstream workflow, not a Website-side team assignment.
ODOO_CRM_TEAM_ID=

# -----------------------------------------------------------------------------
# Odoo Public RFQ Intake API v1 — POST /api/v1/rfq
# (docs/integrations/odoo/rfq-v1/RFQ_API_CONTRACT_V1.md, DAR-041,
# docs/ODOO_RFQ_API_INTEGRATION.md). Deliberately its own credential, never
# the legacy ODOO_API_KEY above (different Odoo permission model/route). No
# value has been minted yet — see the Phase 6B report's own "NOT READY FOR
# CLOUDFLARE RFQ INTEGRATION" verdict; provisioning is Deployment Stage 1,
# not this task. Real value is a Cloudflare Secret
# (`wrangler secret put ODOO_RFQ_API_TOKEN --env <env>`), never committed
# here.
# -----------------------------------------------------------------------------
ODOO_RFQ_API_TOKEN=

# -----------------------------------------------------------------------------
# RFQ / uploads / anti-abuse. Names only, no values — real values are
# Cloudflare Secrets (`wrangler secret put ... --env <env>`), never here.
# -----------------------------------------------------------------------------
# Turnstile server-side Siteverify secret (lib/security/turnstile.ts).
# Mandatory: without it, POST /api/rfqs fails closed with SERVICE_UNAVAILABLE
# for every submission (CLAUDE.md "Fail Closed") — this is deliberate, not a
# bug, until a real Turnstile widget/secret pair is provisioned for the
# actual protected hostname. See README.md "RFQ abuse protection".
TURNSTILE_SECRET_KEY=
EMAIL_API_TOKEN=
INQUIRY_REFERENCE_SECRET=
UPLOAD_SIGNING_SECRET=
WEBHOOK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare bindings (see wrangler.jsonc — not set via .env; listed here
# only for local-dev documentation of what the app expects to exist)
# -----------------------------------------------------------------------------
# D1:    DB_PUBLIC, DB_OPS
# R2:    PUBLIC_MEDIA, RFQ_ATTACHMENTS
# Queue: ODOO_SYNC_QUEUE (producer), ODOO_SYNC_DLQ (integration worker)
